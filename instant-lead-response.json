    {
      "id": "Dedup_Check",
      "name": "Dedup Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -960,
        0
      ],
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nif (!staticData.textedNumbers) staticData.textedNumbers = {};\n\nconst phone = $json.body.phone || ($json.body.customData && $json.body.customData.phone) || ($json.body.contact && $json.body.contact.phone);\nconst name = $json.body.name || ($json.body.customData && $json.body.customData.name) || ($json.body.contact && ($json.body.contact.firstName || $json.body.contact.name)) || null;\nconst now = Date.now();\nconst tenMinMs = 10 * 60 * 1000;\nconst lastTexted = staticData.textedNumbers[phone];\nconst isDuplicate = Boolean(lastTexted) && (now - lastTexted) < tenMinMs;\n\nreturn [{\n  json: {\n    ...$json.body,\n    phone,\n    name,\n    isDuplicate,\n    lastTextedAt: lastTexted || null\n  }\n}];"
      }
    },
