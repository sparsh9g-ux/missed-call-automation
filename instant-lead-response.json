    {
      "id": "Filter_Exact_Phone_Match",
      "name": "Filter Exact Phone Match",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -360,
        -100
      ],
      "parameters": {
        "jsCode": "// GHL's contacts \"query\" param does not reliably filter server-side (observed returning all contacts regardless of query) - filter client-side for an exact match instead of trusting the API's filtering.\nconst targetPhone = $('Dedup Check').item.json.phone;\nconst all = $json.contacts || [];\nconst matches = all.filter(c => c.phone === targetPhone);\nreturn [{ json: { ...$json, contacts: matches } }];"
      }
    }
