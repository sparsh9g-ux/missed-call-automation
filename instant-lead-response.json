    {
      "id": "Mark_Texted_Update_Dedup_Store",
      "name": "Mark Texted (Update Dedup Store)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        -280
      ],
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData(\"global\");\nif (!staticData.textedNumbers) staticData.textedNumbers = {};\n\nlet phone, contactId;\ntry { phone = $(\"Compose Message: New Lead\").item.json.phone; contactId = $(\"Compose Message: New Lead\").item.json.contactId; } catch (e) {}\nif (!phone) {\n  try { phone = $(\"Compose Message: Repeat Customer\").item.json.phone; contactId = $(\"Compose Message: Repeat Customer\").item.json.contactId; } catch (e) {}\n}\n\nstaticData.textedNumbers[phone] = Date.now();\nreturn [{ json: { ...$json, phone, contactId, textedAt: new Date().toISOString() } }];"
      }
    },
