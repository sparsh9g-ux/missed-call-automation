    {
      "id": "Dedup_Check",
      "name": "Dedup Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -960,
        0
      ],
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nif (!staticData.reviewRequestedNumbers) staticData.reviewRequestedNumbers = {};\n\nconst phone = $json.body.phone || ($json.body.customData && $json.body.customData.phone) || ($json.body.contact && $json.body.contact.phone);\nconst name = $json.body.name || ($json.body.customData && $json.body.customData.name) || ($json.body.contact && ($json.body.contact.firstName || $json.body.contact.name)) || null;\nconst now = Date.now();\nconst thirtyDaysMs = 30 * 24 * 60 * 60 * 1000;\nconst lastRequested = staticData.reviewRequestedNumbers[phone];\nconst isDuplicate = Boolean(lastRequested) && (now - lastRequested) < thirtyDaysMs;\n\nreturn [{\n  json: {\n    ...$json.body,\n    phone,\n    name,\n    isDuplicate,\n    lastRequestedAt: lastRequested || null\n  }\n}];"
      }
    },
