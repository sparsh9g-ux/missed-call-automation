    {
      "id": "Mark_Requested_Update_Dedup_Store",
      "name": "Mark Texted (Update Dedup Store)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        -280
      ],
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData(\"global\");\nif (!staticData.reviewRequestedNumbers) staticData.reviewRequestedNumbers = {};\n\nlet phone, contactId;\ntry { phone = $(\"Compose Message: Review Request\").item.json.phone; contactId = $(\"Compose Message: Review Request\").item.json.contactId; } catch (e) {}\n\nstaticData.reviewRequestedNumbers[phone] = Date.now();\nreturn [{ json: { ...$json, phone, contactId, requestedAt: new Date().toISOString() } }];"
      }
    },
